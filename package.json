    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@streamparser/json": "^0.0.26",
    "@zip.js/zip.js": "^2.23.0",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0"
  }
}
