  "private": true,
  "description": "Estimates the CO2 of your AI use from the tokens you have already spent. Runs in your browser; nothing is uploaded.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
