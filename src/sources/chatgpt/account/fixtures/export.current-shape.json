        "message": {
          "author": {
            "name": null,
            "role": "assistant"
          },
          "content": {
            "content_type": "text",
            "parts": [
              "At 20 \u00b0C, once a day is enough.\n\n- Keep 20 g of starter.\n- Add 40 g flour and 40 g water.\n\nIf it peaks in under 8 hours, feed twice a day."
            ]
          },
          "create_time": 1789999632.712,
          "id": "90f55cc0-c3dd-466b-8893-ca1d098b327a",
